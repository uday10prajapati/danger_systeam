{
  "name": "superstore-desktop",
  "version": "1.0.0",
  "description": "Desktop supermarket management application",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:electron": "cd electron && npx electron main.js",
    "dev:full": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build": "npm run build --workspace=frontend",
    "start": "cd electron && npx electron main.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "workspaces": [
    "backend",
    "frontend",
    "electron"
  ],
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^7.0.1"
  },
  "build": {
    "asar": false,
    "appId": "com.superstore.desktop",
    "productName": "SuperStore",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "backend/.env",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
